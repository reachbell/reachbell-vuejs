{
  "name": "@reachbell/vue",
  "version": "1.1.0",
  "description": "Vue 3 composable + Provider for the ReachBell SDK — push notifications, identify, tag.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "reachbell",
    "vue",
    "vue3",
    "push notifications",
    "web push",
    "composable"
  ],
  "author": "DotSpheres Technologies Pvt Ltd",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@reachbell/sdk": "^1.1.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "tslib": "^2.6.0",
    "vue": "^3.4.0",
    "@reachbell/sdk": "file:../reachbell-sdk"
  }
}
